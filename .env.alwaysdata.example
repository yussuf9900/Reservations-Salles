# ==============================================================================
# Configuration Alwaysdata (Production) - Réservation de Salles
# ==============================================================================

# Environnement de production
APP_ENV=production
APP_DEBUG=false

# Format d'affichage : 'html' (interface web) ou 'json' (API)
APP_RESPONSE_FORMAT=html

# Configuration de la base de données MySQL Alwaysdata
# Note : En local sur Alwaysdata, DB_HOST peut être 'localhost' ou 'mysql-<compte>.alwaysdata.net'
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=votrecompte_reservation_salles
DB_USERNAME=votrecompte
DB_PASSWORD=votre_mot_de_passe_secret
