# Ports exposes sur la machine hote par Docker Compose
APP_PORT=8080
FORWARD_DB_PORT=3306

# Configuration de l'application
APP_ENV=development
APP_DEBUG=true

# Configuration de la base de donnees (hors Docker ou acces direct)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservation_salles
DB_USERNAME=root
DB_PASSWORD=
