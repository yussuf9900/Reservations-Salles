# Ports exposes sur la machine hote par Docker Compose
APP_PORT=8080
FORWARD_DB_PORT=3307
PMA_PORT=8081

# Configuration de l'application
APP_ENV=development
APP_DEBUG=true
# Format d'affichage exclusivement configure ici des donnees : 'html' (interface web) ou 'json' (donnees brutes / API)
APP_RESPONSE_FORMAT=html

# Configuration de la base de donnees (hors Docker ou acces direct)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservation_salles
DB_USERNAME=root
DB_PASSWORD=

DOCKER_DB_USERNAME=reservation_app
DOCKER_DB_PASSWORD=reservation_local
DOCKER_DB_ROOT_PASSWORD=root_local
