        'batiment' => 'Bâtiment Administratif',
        'capacite' => 12,
        'type'     => 'reunion',
        'active'   => true,
    ],
];

foreach ($sallesInitiales as $salleData) {
    $salle = Salle::updateOrCreate(
        ['nom' => $salleData['nom']],
        $salleData
    );
    fwrite(STDOUT, "[SEED] Salle synchronisee : " . $salle->nom . " (" . $salle->capacite . " places, " . $salle->type . ")\n");
