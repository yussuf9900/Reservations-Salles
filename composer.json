{
    "name": "odc/reservation-salles",
    "description": "Système de réservation de salles universitaires en PHP POO",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3",
        "nikic/fast-route": "^1.3",
        "respect/validation": "^2.4",
        "illuminate/database": "^11.0 || ^12.0",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
